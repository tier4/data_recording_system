# /etc/systemd/system/drs-transfer.service
[Unit]
Description=Sync ROS bag data to storage (NAS or External SSD)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ drs_transfer_script_path }}
User=root
StandardOutput=journal
StandardError=journal

# Resource limits
CPUQuota={{ drs_transfer_cpu_quota }}
IOWeight={{ drs_transfer_io_weight }}
Nice=19

# Retry on failure
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
