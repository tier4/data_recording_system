#!/bin/bash

# drs_transfer.sh - Synchronize sensor data to storage (NAS or External SSD)

# Configuration
SOURCE_DIR="{{ drs_transfer_source_dir }}"
HOSTNAME="{{ drs_transfer_hostname }}"
LOCK_FILE="{{ drs_transfer_lock_file }}"
RSYNC_BW_LIMIT="{{ drs_transfer_rsync_bw_limit }}"  # rsync bandwidth limit
FREE_SPACE_LIMIT_GB={{ drs_transfer_free_space_limit_gb | int }}

# Destinations (Priority order)
# Ansible will expand the list here
DESTINATIONS=(
{% for dest in drs_transfer_destinations %}
    "{{ dest }}"
{% endfor %}
)

# Error handling
error_exit() {
    echo "ERROR: $1"
    exit 1
}

# Pre-create lock file with restrictive permissions so umask does not make it world-writable
install -m 0600 /dev/null "$LOCK_FILE" || error_exit "Cannot create lock file: $LOCK_FILE"

# Main execution block with flock
(
    # Exclusive lock with non-blocking check
    flock -n "$fd" || error_exit "Already running."

    # Validate source directory exists before attempting any file operations
    [ -d "$SOURCE_DIR" ] || error_exit "SOURCE_DIR does not exist or is not mounted: $SOURCE_DIR"

    # Select Destination
    TARGET_BASE_DIR=""

    # Trigger automounts for all destinations in parallel.
    # Each trigger is bounded by a timeout so unavailable mounts do not block
    # the script beyond the timer interval (DefaultDeviceTimeoutSec / NFS TCP
    # timeouts can far exceed the configured x-systemd.mount-timeout values).
    echo "Triggering automounts..."
    for dest in "${DESTINATIONS[@]}"; do
        [ -n "$dest" ] && timeout {{ drs_transfer_automount_trigger_timeout_sec | int }} ls "$dest" > /dev/null 2>&1 &
    done
    wait

    for dest in "${DESTINATIONS[@]}"; do
        # Skip empty entries
        if [ -z "$dest" ]; then
            continue
        fi

        echo "Checking destination: $dest"

        # Check if directory exists
        if [ ! -d "$dest" ]; then
            echo "  Skipping: Directory does not exist."
            continue
        fi

        # Check if it is a mountpoint
        if ! mountpoint -q "$dest"; then
             echo "  Skipping: $dest is not a mountpoint."
             continue
        fi

        # Check free space
        # df output: Filesystem 1K-blocks Used Available Use% Mounted on
        # We want Available (4th column) in KB
        available_kb=$(df -k --output=avail "$dest" | tail -n 1)

        # Convert Limit to KB
        limit_kb=$((FREE_SPACE_LIMIT_GB * 1024 * 1024))

        if [ "$available_kb" -ge "$limit_kb" ]; then
            echo "  Selected: Enough free space available ($((available_kb / 1024 / 1024)) GB)."
            TARGET_BASE_DIR="$dest"
            break
        else
            echo "  Skipping: Not enough free space (Available: $((available_kb / 1024 / 1024)) GB, Limit: $FREE_SPACE_LIMIT_GB GB)."
        fi
    done

    if [ -z "$TARGET_BASE_DIR" ]; then
        error_exit "No suitable destination found with enough free space."
    fi

    DEST_DIR="${TARGET_BASE_DIR}/${HOSTNAME}"

    # Create destination directory with broad permissions for multi-user data access.
    # chmod after mkdir because -m only applies to the leaf when using -p.
    mkdir -p "$DEST_DIR" && chmod 777 "$DEST_DIR" || error_exit "Failed to create destination directory: $DEST_DIR"

    # Process files for transfer
    echo "Starting backup process to $DEST_DIR"

    transfer_failed=0

    # Find mcap files and sort by modification time (oldest first).
    # Use process substitution so transfer_failed is visible after the loop.
    while IFS= read -r mcap_file; do

        # Skip files modified within the threshold (i.e., recording is still active or
        # just finished). Avoids fuser/lsof which cause excessive NFS stat() calls when
        # SOURCE_DIR or DEST is on a NAS mount, leading to severe slowdowns.
        # On stat failure, skip rather than proceeding — the file will be retried next tick.
        if ! file_mtime=$(stat -c %Y "$mcap_file" 2>/dev/null); then
            echo "Skipping (stat failed): $mcap_file"
            continue
        fi
        now=$(date +%s)
        if [ $((now - file_mtime)) -lt {{ drs_transfer_active_file_threshold_sec | int }} ]; then
            echo "Skipping recently modified file (active within {{ drs_transfer_active_file_threshold_sec | int }}s): $mcap_file"
            continue
        fi

        # Get relative path (to preserve directory structure)
        relative_path="${mcap_file#$SOURCE_DIR/}"
        dest_file="$DEST_DIR/$relative_path"
        dest_dir=$(dirname "$dest_file")

        # Create destination directory with broad permissions for multi-user data access.
        # chmod after mkdir because -m only applies to the leaf when using -p.
        mkdir -p "$dest_dir" && chmod 777 "$dest_dir"

        # Get file size (for logging)
        file_size=$(stat -c %s "$mcap_file" 2>/dev/null || echo "0")
        file_size_mb=$((file_size / 1048576))

        echo "Starting transfer: $relative_path (${file_size_mb}MB)"

        # Transfer with rsync (low priority)
        # ionice: Set I/O priority to lowest
        # nice: Set CPU priority to low
        # rsync: Bandwidth limit, checksum verification, no progress
        if ionice -c 3 nice -n 19 rsync \
            --bwlimit="$RSYNC_BW_LIMIT" \
            --chmod=F666,D777 \
            --checksum \
            --no-progress \
            "$mcap_file" \
            "$dest_file"; then

            # Transfer successful, delete source file
            rm -f "$mcap_file"
            echo "Transfer completed and deleted: $relative_path"

            # Remove empty directories
            src_dir=$(dirname "$mcap_file")
            if [ -d "$src_dir" ] && [ -z "$(ls -A "$src_dir")" ]; then
                rmdir "$src_dir" 2>/dev/null
            fi
        else
            echo "ERROR: Transfer failed: $relative_path"
            transfer_failed=1
        fi

        # Check free space again to stop if we are running low
        available_kb=$(df -k --output=avail "$TARGET_BASE_DIR" | tail -n 1)
        limit_kb=$((FREE_SPACE_LIMIT_GB * 1024 * 1024))

        if [ "$available_kb" -lt "$limit_kb" ]; then
             echo "WARNING: Free space below limit ($((available_kb / 1024 / 1024)) GB < $FREE_SPACE_LIMIT_GB GB). Stopping transfer."
             break
        fi

        # Short sleep to reduce CPU load
        sleep 0.1
    done < <(find "$SOURCE_DIR" -name "*.mcap" -type f -printf '%T@ %p\n' | sort -n | cut -d' ' -f2-)

    if [ "$transfer_failed" -ne 0 ]; then
        error_exit "One or more file transfers failed. See logs above for details."
    fi

    # Cleanup directories with only metadata.yaml
    echo "Starting empty directory cleanup"
    find "$SOURCE_DIR" -mindepth 1 -maxdepth 1 -type d | while IFS= read -r dir; do
        # Count files in directory (excluding metadata.yaml)
        mcap_count=$(find "$dir" -name "*.mcap" -type f | wc -l)

        if [ $mcap_count -eq 0 ]; then
            # No mcap files present
            if [ -f "$dir/metadata.yaml" ]; then
                # Symlink guard: check at rm-time since find -type d doesn't follow symlinks,
                # but a directory can be replaced with a symlink between find and rm -rf (TOCTOU).
                [ ! -L "$dir" ] || { echo "Skipping symlink (safety): $dir"; continue; }
                echo "Removing directory with only metadata.yaml: $(basename "$dir")"
                rm -rf "$dir"
            elif [ -z "$(ls -A "$dir")" ]; then
                # Completely empty directory
                echo "Removing empty directory: $(basename "$dir")"
                rmdir "$dir"
            fi
        fi
    done

    echo "Backup process completed"

) {fd}>"$LOCK_FILE"
