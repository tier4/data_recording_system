[Unit]
Description=DRS Record Launch Service
Requires=network-online.target
After=network-online.target cyclonedds-local.service

[Service]
Type=exec
ExecStart=/opt/drs/service/drs_recorder/launch.sh
Restart=on-failure
RestartSec=5
User={{ drs_user }}
Group={{ drs_group }}

# Process management
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30

# Logging configuration (journald)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drs-recorder

[Install]
WantedBy=multi-user.target
