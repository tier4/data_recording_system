[Unit]
Description=DRS Launch Service
Requires=network-online.target systemd-modules-load.service
After=network-online.target cyclonedds-local.service systemd-modules-load.service

[Service]
Type=exec
ExecStart=/opt/drs/service/drs_sensor/launch.sh
Restart=on-failure
RestartSec=5
User={{ drs_user }}
Group={{ drs_group }}

# Process management
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30

# Real-time scheduling capabilities
AmbientCapabilities=CAP_SYS_NICE
LimitRTPRIO={{ sensor_trigger_rtprio | default(85) }}
LimitMEMLOCK={{ sensor_trigger_memlock | default('infinity') }}

# Logging configuration (journald)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drs-launch

[Install]
WantedBy=multi-user.target
