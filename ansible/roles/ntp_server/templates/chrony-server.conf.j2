# NTP Server Configuration for DRS
# This distributes PTP-synchronized system time as NTP server
# {{ ansible_managed }}

# Use local time source (PTP-synchronized system time)
local stratum {{ ntp_server_stratum }}

# Allow NTP queries from specified networks
{% for network in ntp_server_allow_networks %}
allow {{ network }}
{% endfor %}

# Record the rate at which the system clock gains/losses time
driftfile /var/lib/chrony/drift

# Enable kernel synchronisation of the real-time clock
rtcsync
