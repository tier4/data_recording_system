exclude_paths:
  - src/

skip_list:
  - meta-no-info # We don't publish to Ansible Galaxy.
  - package-latest # Since this is a development environment, we allow the latest versions.
  - no-handler # Tasks that run when changed should likely be handlers
  - ignore-errors # Use failed_when and specify error conditions
  - risky-shell-pipe # Shells that use pipes should set the pipefail option
  - command-instead-of-module # Using command rather than module
  - schema[meta] # Skip meta file schema validation to avoid CI-only errors

warn_list: []
