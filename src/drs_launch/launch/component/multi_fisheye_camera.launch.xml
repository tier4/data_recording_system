        <arg name="name" value="camera9"/>
        <arg name="udp_port" value="5005"/>
        <arg name="frame_id" value="camera9/camera_optical_link"/>
        <arg name="width" value="1920"/>
        <arg name="height" value="1280"/>
        <arg name="jpeg_quality" value="80"/>
        <arg name="publish_raw" value="false"/>
        <arg name="publish_compressed" value="true"/>
        <arg name="camera_info_url" value="file://$(var param_root_dir)/camera9/camera_info.yaml"/>
      </include>
    </group>

    <group if="$(eval &quot;'all' == '$(var launch_cameras)' or '10' in '$(var launch_cameras)'.replace(' ','').split(',')&quot;)">
      <include file="$(find-pkg-share drs_launch)/launch/component/rtp_image_receiver.launch.xml">
        <arg name="namespace" value="camera"/>
        <arg name="name" value="camera10"/>
        <arg name="udp_port" value="5006"/>
        <arg name="frame_id" value="camera10/camera_optical_link"/>
        <arg name="width" value="1920"/>
        <arg name="height" value="1280"/>
        <arg name="jpeg_quality" value="80"/>
        <arg name="publish_raw" value="false"/>
        <arg name="publish_compressed" value="true"/>
        <arg name="camera_info_url" value="file://$(var param_root_dir)/camera10/camera_info.yaml"/>
      </include>
    </group>

    <group if="$(eval &quot;'all' == '$(var launch_cameras)' or '11' in '$(var launch_cameras)'.replace(' ','').split(',')&quot;)">
      <include file="$(find-pkg-share drs_launch)/launch/component/rtp_image_receiver.launch.xml">
        <arg name="namespace" value="camera"/>
        <arg name="name" value="camera11"/>
        <arg name="udp_port" value="5007"/>
        <arg name="frame_id" value="camera11/camera_optical_link"/>
        <arg name="width" value="1920"/>
        <arg name="height" value="1280"/>
        <arg name="jpeg_quality" value="80"/>
        <arg name="publish_raw" value="false"/>
        <arg name="publish_compressed" value="true"/>
        <arg name="camera_info_url" value="file://$(var param_root_dir)/camera11/camera_info.yaml"/>
      </include>
    </group>
  </group>
</launch>
