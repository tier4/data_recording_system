<?xml version="1.0"?>
<launch>
  <arg name="param_root_dir"/>
  <arg name="launch_cameras" default="all"/>
  <group>
    <group if="$(eval &quot;'all' == '$(var launch_cameras)' or '8' in '$(var launch_cameras)'.replace(' ','').split(',')&quot;)">
      <include file="$(find-pkg-share drs_launch)/launch/component/rtp_image_receiver.launch.xml">
        <arg name="namespace" value="camera"/>
        <arg name="name" value="camera8"/>
        <arg name="udp_port" value="5004"/>
        <arg name="frame_id" value="camera8/camera_optical_link"/>
        <arg name="width" value="1920"/>
        <arg name="height" value="1280"/>
        <arg name="jpeg_quality" value="80"/>
        <arg name="publish_raw" value="false"/>
        <arg name="publish_compressed" value="true"/>
        <arg name="camera_info_url" value="file://$(var param_root_dir)/camera8/camera_info.yaml"/>
      </include>
    </group>

    <group if="$(eval &quot;'all' == '$(var launch_cameras)' or '9' in '$(var launch_cameras)'.replace(' ','').split(',')&quot;)">
