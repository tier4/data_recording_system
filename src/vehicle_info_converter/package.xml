<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_info_converter</name>
  <version>0.0.0</version>
  <description>ROS2 node to convert CAN messages to Autoware vehicle messages.</description>
  <maintainer email="v-shimaki2507@tier4.jp">Akihiko Shimizu</maintainer>
  <license>Apache License 2.0</license>
<!-- Note: Requires python3-cantools (rosdep) -->

  <depend>rclpy</depend>
  <depend>can_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
